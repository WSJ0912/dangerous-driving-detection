# ============================================================
# 智慧驭行驾驶行为检测系统 - Git 忽略规则
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
*.spec

# ---- 虚拟环境 ----
.venv/
venv/
env/
backend/.venv/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- 编辑器与 Office 临时文件 ----
*~
~$*
*.tmp

# ---- 早期临时脚本残留（非项目代码，已从版本库移除，仅保留在本地）----
深度学习/

# ---- 第三方 YOLO 部署 demo 包（约 123 MB，非本项目源码，仅本地参考）----
yolo11-drive/

# ---- 交付/申报材料（约 53 MB，含个人与单位信息，禁止入库）----
软著材料_初版/

# ---- 旧发布快照（约 1.2 GB，2026-05-05 的旧架构产物，不可直接交付）----
release/

# ---- 模型权重（体积大且为第三方权重，不入库；clone 后需自行放置）----
models/weights/*.pt
*.pt
*.onnx

# ---- 数据集与训练产物（仓库内只有 .gitkeep，无真实数据）----
data/raw/
data/yolo_format/
training/experiments/
training/data.yaml
*.cache

# ---- 运行时数据 ----
uploads/
backend/uploads/alerts/
backend/data/
*.log

# ---- 测试与审计过程产物 ----
.pytest_cache/
.agents/
_审计报告/

# ---- 前端构建产物（当前后端服务 frontend_web 根目录，dist/ 为历史残留）----
frontend_web/dist/

# ============================================================
# 沙箱 / 环境残留（非项目内容，可手动删除，不影响运行）
# ------------------------------------------------------------
# 以下条目由本机沙箱与写文件工具在修复过程中产生，
# 目前无法自动清除，故在此排除以免误入版本库。
# ============================================================
_gittest/
_guard_test_root.txt
_guard_test_dir/
.*tmpdir/
backend/uploads/alerts/_*probe*
backend/uploads/alerts/_t1_probe.txt